# ==============================================================================
# CalMeet Environment Configuration (Example Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# For Supabase, use the Transaction Pooler (port 6543 with ?pgbouncer=true) for DATABASE_URL
# and Session Pooler (port 5432) or direct connection for DIRECT_URL (required for migrations)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH CONFIGURATION & SECURITY
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change_this_to_a_random_32_character_secret_key"

# Comma-separated list of authorized administrator emails
ADMIN_EMAILS="admin@example.com,owner@example.com"

# Secret required to trigger automated cron jobs (/api/cron/reminders)
CRON_SECRET="change_this_to_a_random_secure_cron_secret"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH & GOOGLE CALENDAR
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. ZOOM INTEGRATION
# ------------------------------------------------------------------------------
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"
ZOOM_REDIRECT_URI="http://localhost:3000/api/auth/callback/zoom"
ZOOM_SECRET_TOKEN="your-zoom-secret-token"

# ------------------------------------------------------------------------------
# 5. GITHUB OAUTH
# ------------------------------------------------------------------------------
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"

# ------------------------------------------------------------------------------
# 6. SUPABASE (Auth & Database Sync)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICES
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
SMTP_USER="notifications@yourdomain.com"
SMTP_PASSWORD="your-smtp-password"

# ------------------------------------------------------------------------------
# 8. CLOUDINARY (Avatars & Brand Assets)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 9. PAYMENTS (Paid Event Types & Plan Upgrades)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
STRIPE_API_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
